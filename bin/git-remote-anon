#!/bin/sh
# git-remote-anon — git remote helper that hides real remote URLs.
#
# A remote URL of the form `anon::<alias>` makes git run:
#     git-remote-anon <remote-name> <alias>
# The alias is resolved via ~/.config/git-anon/map (one `alias real_url` per
# line, `#` comments), so .git/config and `git remote -v` never contain the
# real host or path.
#
# HTTPS is delegated to git's own helper. SSH and local paths speak the
# helper `connect` protocol here and then exec the service directly, so the
# helper exits as soon as the server side does (git remote-ext would not,
# because git's dispatcher process keeps the pipe to git open).

set -eu

MAP="${GIT_ANON_MAP:-${XDG_CONFIG_HOME:-$HOME/.config}/git-anon/map}"

die() { echo "git-remote-anon: $*" >&2; exit 1; }

[ $# -ge 2 ] || die "usage: git-remote-anon <remote> <alias>"
remote=$1
alias=$2

case "$alias" in
  ''|*[!A-Za-z0-9._-]*) die "invalid alias '$alias' (allowed: A-Z a-z 0-9 . _ -)" ;;
esac
[ -r "$MAP" ] || die "map file not found: $MAP"

real=$(awk -v k="$alias" '!/^[[:space:]]*(#|$)/ && $1 == k { print $2; exit }' "$MAP")
[ -n "$real" ] || die "unknown alias '$alias'"

case "$real" in
  https://*) exec git remote-https "$remote" "$real" ;;
  http://*)  exec git remote-http  "$remote" "$real" ;;
esac

# The path ends up inside a remote shell command; refuse anything that could
# break out of the single quotes we put around it.
case "$real" in
  *[[:space:]\'\"\\\`\$\;\&\|\<\>]*) die "alias '$alias': unsupported character in URL" ;;
esac

host=; port=; path=
case "$real" in
  ssh://*|git+ssh://*|ssh+git://*)
    rest=${real#*://}
    host=${rest%%/*}
    path=/${rest#*/}
    case "$host" in
      *:*) port=${host##*:}; host=${host%:*} ;;
    esac
    ;;
  file://*) path=${real#file://} ;;
  /*)       path=$real ;;
  *:*)      host=${real%%:*}; path=${real#*:} ;;
  *)        die "alias '$alias': unsupported URL form" ;;
esac
case "$host" in -*) die "alias '$alias': invalid host" ;; esac

# Helper protocol: advertise `connect`, then hand stdin/stdout to the service.
# `read` consumes the pipe byte by byte, so nothing meant for the service is lost.
service=
while IFS= read -r line; do
  case "$line" in
    capabilities) printf 'connect\n\n' ;;
    connect\ *)   service=${line#connect }; break ;;
    '')           exit 0 ;;
    *)            die "unsupported helper command: $line" ;;
  esac
done
case "$service" in
  git-upload-pack|git-receive-pack|git-upload-archive) ;;
  *) die "unsupported service '$service'" ;;
esac
printf '\n'

if [ -z "$host" ]; then
  exec git "${service#git-}" "$path"
fi

# Same precedence as git: GIT_SSH_COMMAND, core.sshCommand, GIT_SSH, ssh.
ssh_cmd=${GIT_SSH_COMMAND:-$(git config --get core.sshCommand 2>/dev/null || true)}
if [ -n "$ssh_cmd" ]; then
  set -- sh -c "$ssh_cmd \"\$@\"" ssh
else
  set -- "${GIT_SSH:-ssh}"
fi
if [ -n "$port" ]; then
  set -- "$@" -p "$port"
fi
exec "$@" "$host" "$service '$path'"
