#!/bin/sh
# git anon — hide real git remote URLs behind local aliases.
#
# Real URLs live only in ~/.config/git-anon/map; .git/config holds
# `anon::<alias>`, which git resolves through git-remote-anon.

set -eu

VERSION=0.4.0
SCRUB=
NESTED=
MAP="${GIT_ANON_MAP:-${XDG_CONFIG_HOME:-$HOME/.config}/git-anon/map}"

usage() {
  cat <<'EOF'
usage: git anon <command> [args]

  init [--alias NAME] [--scrub-reflog] [--nested]
                         anonymize every remote of the current repo and its submodules;
                         --scrub-reflog also removes the real URL from reflogs (slow
                         on repos with many refs); --nested also handles independent
                         git repos cloned inside the working tree (walks the tree)
  off [--nested]         restore every remote of the current repo and its submodules
  status [--nested]      show which remotes and submodules are anonymized
  update                 like `git submodule update --init --recursive`, anonymizing
                         each level before cloning the next

  add <alias> [remote]   anonymize one remote (default: origin) with a chosen alias
  restore [remote]       restore one remote (default: origin)
  list                   list known aliases (never prints URLs)
  show <alias>           print the real URL behind an alias
  clone [--recurse-submodules] <alias> [dir]
                         clone through an alias
  version                print version
EOF
}

die() { echo "git anon: $*" >&2; exit 1; }

valid_alias() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) die "invalid alias '$1' (allowed: A-Z a-z 0-9 . _ -)" ;;
  esac
}

in_repo() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"
}

ensure_map() {
  mapdir=$(dirname "$MAP")
  [ -d "$mapdir" ] || { mkdir -p "$mapdir"; chmod 700 "$mapdir"; }
  [ -f "$MAP" ] || (umask 077; : > "$MAP")
  chmod 600 "$MAP"
}

lookup() {
  [ -r "$MAP" ] || return 0
  awk -v k="$1" '!/^[[:space:]]*(#|$)/ && $1 == k { print $2; exit }' "$MAP"
}

rand_hex() {
  od -An -N4 -tx1 /dev/urandom | tr -d ' \n'
}

add_entry() {  # alias url
  existing=$(lookup "$1")
  if [ -n "$existing" ]; then
    [ "$existing" = "$2" ] && return 0
    die "alias '$1' already maps to a different URL"
  fi
  printf '%s %s\n' "$1" "$2" >> "$MAP"
}

# pick_alias <wanted> <url>: <wanted> if it is free or already maps to <url>,
# otherwise <wanted>-<random>.
pick_alias() {
  cand=$1
  while :; do
    existing=$(lookup "$cand")
    if [ -z "$existing" ] || [ "$existing" = "$2" ]; then
      echo "$cand"
      return 0
    fi
    cand="$1-$(rand_hex)"
  done
}

san() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'
}

# strip_userinfo <url>: the form git writes into reflogs and FETCH_HEAD,
# with `user@` / `user:password@` removed.
strip_userinfo() {
  case "$1" in
    *://*@*) printf '%s\n' "$1" | sed -E 's#^([a-z+]+://)[^/@]*@#\1#' ;;
    *://*)   printf '%s\n' "$1" ;;
    *@*:*)   printf '%s\n' "${1#*@}" ;;
    *)       printf '%s\n' "$1" ;;
  esac
}

# scrub_traces <real-url> <replacement>: git also records the URL outside the
# config, e.g. "clone: from <url>" in reflogs and in FETCH_HEAD. Opt-in
# (`init --scrub-reflog`): replace the URL text there, both verbatim and in
# the user-stripped form git writes. Reflog structure is untouched.
scrub_traces() {
  [ -n "$SCRUB" ] && [ -n "$1" ] || return 0
  bare=$(strip_userinfo "$1")
  gd=$(git rev-parse --git-dir)
  cd_=$(git rev-parse --git-common-dir)
  scrub_dir "$gd" "$1" "$bare" "$2"
  if [ "$(cd "$cd_" && pwd -P)" != "$(cd "$gd" && pwd -P)" ]; then
    scrub_dir "$cd_" "$1" "$bare" "$2"
  fi
  for w in "$cd_"/worktrees/*; do
    [ -d "$w" ] || continue
    [ "$(cd "$w" && pwd -P)" = "$(cd "$gd" && pwd -P)" ] || scrub_dir "$w" "$1" "$bare" "$2"
  done
}

# scrub_dir <git-dir> <url> <bare-url> <replacement>: one grep finds the few
# files that mention the URL, so the cost does not grow with the ref count.
scrub_dir() {
  grep -rlF -e "$2" -e "$3" "$1/logs" "$1/FETCH_HEAD" 2>/dev/null |
    while IFS= read -r f; do
      case "$f" in
        "$1"/logs/*) lock="$1/${f#"$1"/logs/}.lock" ;;  # the ref's lock, as git uses
        *) lock= ;;
      esac
      rewrite_file "$f" "$2" "$3" "$4" "$lock" && echo "scrubbed real URL from ${f#"$1"/}"
    done
}

# rewrite_file <file> <from1> <from2> <to> [lock]: replace literal strings,
# holding the ref lock so a concurrent git cannot append in between, and
# swapping the file in atomically.
rewrite_file() {
  if [ -n "$5" ]; then
    mkdir -p "$(dirname "$5")"
    if ! (set -C; : > "$5") 2>/dev/null; then
      echo "warning: ${5##*/} is locked (is git running?); skipped $1" >&2
      return 1
    fi
  fi
  tmp="$1.anon-tmp.$$"
  ok=
  if awk -v a="$2" -v b="$3" -v to="$4" '
    function rep(line, from,   out, i) {
      out = ""
      while ((i = index(line, from)) > 0) {
        out = out substr(line, 1, i - 1) to
        line = substr(line, i + length(from))
      }
      return out line
    }
    { print rep(rep($0, a), b) }' "$1" > "$tmp" && mv -f "$tmp" "$1"; then
    ok=1
  fi
  rm -f "$tmp"
  [ -z "$5" ] || rm -f "$5"
  [ -n "$ok" ] || { echo "warning: could not rewrite $1" >&2; return 1; }
}

# anonymize_key <remote> <url|pushurl> <alias> [auto]; returns 1 if the key is unset.
# With `auto`, a taken alias is replaced by a free one instead of failing.
anonymize_key() {
  n=$(git config --get-all "remote.$1.$2" | wc -l | tr -d ' ')
  [ "$n" -gt 0 ] || return 1
  [ "$n" -eq 1 ] || die "remote.$1.$2 has $n values; anonymize it manually"
  cur=$(git config --get "remote.$1.$2")
  case "$cur" in
    anon::*)
      echo "remote.$1.$2 already anonymized ($cur)"
      scrub_traces "$(lookup "${cur#anon::}")" "$cur"
      return 0
      ;;
    *[[:space:]]*) die "remote.$1.$2 contains whitespace" ;;
  esac
  al=$3
  [ "${4:-}" != auto ] || al=$(pick_alias "$3" "$cur")
  add_entry "$al" "$cur"
  git config "remote.$1.$2" "anon::$al"
  echo "remote.$1.$2 -> anon::$al"
  scrub_traces "$cur" "anon::$al"
}

restore_key() {  # remote url|pushurl
  cur=$(git config --get "remote.$1.$2" || true)
  case "$cur" in
    anon::*) ;;
    *) return 0 ;;
  esac
  a=${cur#anon::}
  real=$(lookup "$a")
  [ -n "$real" ] || die "alias '$a' not found in $MAP"
  git config "remote.$1.$2" "$real"
  echo "remote.$1.$2 restored"
}

anonymize_remote() {  # remote alias [auto]
  valid_alias "$2"
  anonymize_key "$1" url "$2" "${3:-}" || die "remote '$1' has no url"
  if git config --get "remote.$1.pushurl" >/dev/null; then
    anonymize_key "$1" pushurl "$2.push" "${3:-}"
  fi
}

# ---- submodules -----------------------------------------------------------
# All functions below operate on the repository in the current directory,
# which must be its top level. Recursion into submodules happens in
# subshells, so the plain (non-local) variables do not clash.

# ---- cached config reads ---------------------------------------------------
# Starting git can be slow (antivirus/EDR, Windows): read each repo's config
# once and look keys up in memory; only the actual changes call `git config`.

# kv <cache> <key>: value of <key> in `git config --get-regexp` output. Keys are
# as git prints them: section and variable lowercase, subsection verbatim.
kv() {
  printf '%s\n' "$1" | awk -v k="$2" 'index($0, k " ") == 1 { print substr($0, length(k) + 2); exit }'
}

read_remotes() {
  git config --local --get-regexp '^remote\..*\.(url|pushurl)$' 2>/dev/null || true
}

read_local_sub() {
  git config --local --get-regexp '^(submodule|branch)\.' 2>/dev/null || true
}

read_gitmodules() {
  [ -f .gitmodules ] || return 0
  git config -f .gitmodules --get-regexp '^submodule\..*\.(url|path)$' 2>/dev/null || true
}

# names <cache>...: submodule names that have a .url key in any cache.
sub_names() {
  for c in "$@"; do
    printf '%s\n' "$c" | sed -n 's/^submodule\.\(.*\)\.url .*/\1/p'
  done | awk 'NF && !seen[$0]++'
}

# super_real <remotes-cache> <local-cache>: real URL of the remote that relative
# submodule URLs are resolved against (upstream of HEAD's branch, else origin).
super_real() {
  b=$(git symbolic-ref -q --short HEAD || true)
  r=
  [ -z "$b" ] || r=$(kv "$2" "branch.$b.remote")
  u=$(kv "$1" "remote.${r:-origin}.url")
  case "$u" in
    anon::*) lookup "${u#anon::}" ;;
    *) printf '%s\n' "$u" ;;
  esac
}

# resolve_url <base> <url>: resolve a relative submodule URL (./x, ../x) the
# way git does; absolute URLs are returned unchanged.
resolve_url() {
  base=${1%/}
  rel=$2
  case "$rel" in
    ./*|../*) ;;
    *) printf '%s\n' "$rel"; return 0 ;;
  esac
  [ -n "$base" ] || die "cannot resolve relative submodule URL '$rel': superproject has no remote"
  while :; do
    case "$rel" in
      ./*) rel=${rel#./} ;;
      ../*)
        rel=${rel#../}
        case "$base" in
          *://*/*) base=${base%/*} ;;
          *://*)   die "relative submodule URL '$2' goes above the host" ;;
          /*/*)    base=${base%/*} ;;
          *:*/*)   base=${base%/*} ;;
          *:?*)    base=${base%%:*}: ;;
          *)       die "cannot resolve relative submodule URL '$2'" ;;
        esac
        ;;
      *) break ;;
    esac
  done
  case "$base" in
    *:) printf '%s%s\n' "$base" "$rel" ;;
    *)  printf '%s/%s\n' "$base" "$rel" ;;
  esac
}

submodule_names() {
  [ -f .gitmodules ] || return 0
  git config -f .gitmodules --name-only --get-regexp '^submodule\..*\.url$' 2>/dev/null |
    sed 's/^submodule\.//; s/\.url$//'
}

# Submodule clones and fetches refuse unknown protocols unless allowed.
# Allowing `anon` is safe: it can only reach URLs that are in your own map.
ensure_protocol_allowed() {
  [ -z "${ANON_PROTO_OK:-}" ] || return 0
  if ! git config --global --get protocol.anon.allow >/dev/null; then
    git config --global protocol.anon.allow always
    echo "set protocol.anon.allow=always in global git config (needed for submodules)"
  fi
  ANON_PROTO_OK=1
  export ANON_PROTO_OK
}

# anon_remotes <base>: anonymize remote.*.url / pushurl. With an empty <base>,
# reuse origin's alias or pick a random one. Sets RC to the config as read.
anon_remotes() {
  RC=$(read_remotes)
  base=$1
  if [ -z "$base" ]; then
    o=$(kv "$RC" remote.origin.url)
    case "$o" in anon::*) [ -z "$(lookup "${o#anon::}")" ] || base=${o#anon::} ;; esac
    [ -n "$base" ] || base="r$(rand_hex)"
  fi
  [ -n "$RC" ] || return 0
  dup=$(printf '%s\n' "$RC" | awk '{ print $1 }' | sort | uniq -d | head -n 1)
  [ -z "$dup" ] || die "$dup has several values; anonymize it manually"
  while read -r key val; do
    [ -n "$key" ] || continue
    case "$val" in
      anon::*)
        echo "$key already anonymized ($val)"
        scrub_traces "$(lookup "${val#anon::}")" "$val"
        continue
        ;;
      *[[:space:]]*) die "$key contains whitespace" ;;
    esac
    r=${key#remote.}
    kind=${r##*.}
    r=${r%.*}
    if [ "$r" = origin ]; then want=$base; else want="$base-$(san "$r")"; fi
    [ "$kind" = url ] || want="$want.push"
    al=$(pick_alias "$want" "$val")
    add_entry "$al" "$val"
    git config "$key" "anon::$al"
    echo "$key -> anon::$al"
    scrub_traces "$val" "anon::$al"
  done <<EOF
$RC
EOF
}

anon_submodules() {  # base
  LOC=$(read_local_sub)
  GM=$(read_gitmodules)
  names=$(sub_names "$GM" "$LOC")
  [ -n "$names" ] || return 0
  ensure_protocol_allowed
  sreal=$(super_real "$RC" "$LOC")
  gactive=$(kv "$LOC" submodule.active)
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    path=$(kv "$GM" "submodule.$name.path")
    orig=$(kv "$LOC" "submodule.$name.url")
    a=
    cfg=$orig
    case "$cfg" in
      anon::*)
        if [ -n "$(lookup "${cfg#anon::}")" ]; then
          a=${cfg#anon::}
          echo "submodule.$name.url already anonymized ($cfg)"
        else
          cfg=  # e.g. a relative URL git resolved against an anon remote
        fi
        ;;
    esac
    if [ -z "$a" ]; then
      if [ -n "$cfg" ]; then
        real=$cfg
      else
        gmurl=$(kv "$GM" "submodule.$name.url")
        [ -n "$gmurl" ] || continue
        real=$(resolve_url "$sreal" "$gmurl") || exit 1
      fi
      case "$real" in *[[:space:]]*) die "submodule '$name' URL contains whitespace" ;; esac
      a=$(pick_alias "$1-$(san "$name")" "$real")
      add_entry "$a" "$real"
      # Writing submodule.<name>.url would mark an uninitialized submodule
      # active; keep it inactive until the user runs `git submodule init`.
      if [ -z "$orig" ] && [ -z "$gactive" ] && [ -z "$(kv "$LOC" "submodule.$name.active")" ]; then
        git config "submodule.$name.active" false
        git config "submodule.$name.anonInactive" true
      fi
      git config "submodule.$name.url" "anon::$a"
      echo "submodule.$name.url -> anon::$a"
    fi
    if [ -n "$path" ] && [ -e "$path/.git" ]; then
      (cd "$path" && echo "entering '$path'" && anon_repo "$a")
    fi
  done <<EOF
$names
EOF
  n=$(printf '%s\n' "$GM" | grep '^submodule\..*\.url ' | grep -cv ' anon::' || true)
  if [ "$n" -gt 0 ]; then
    echo "note: .gitmodules is tracked and still lists $n submodule URL(s) in plain text"
  fi
}

# module_dirs_with <anon|real>: submodule git dirs under .git/modules (at any
# depth, checked out or not, including leftovers of removed/renamed
# submodules) that have at least one remote URL of that kind. One awk reads
# the config files directly, without starting git per directory.
module_dirs_with() {
  md="$(git rev-parse --git-common-dir)/modules"
  [ -d "$md" ] || return 0
  find "$md" -type f -name config 2>/dev/null |
    while IFS= read -r f; do printf '%s\n' "$f"; done |
    awk -v want="$1" '
      { files[NR] = $0 }
      END {
        for (i = 1; i <= NR; i++) {
          f = files[i]; hit = 0
          while ((getline line < f) > 0) {
            if (line !~ /^[ \t]*(push)?url[ \t]*=/) continue
            v = line; sub(/^[^=]*=[ \t]*/, "", v); gsub(/"/, "", v)
            if ((want == "anon") == (v ~ /^anon::/)) hit = 1
          }
          close(f)
          if (hit) { sub(/\/config$/, "", f); print f }
        }
      }'
}

# anon_module_dirs <base>: anonymize remotes in submodule git dirs that the
# checked-out recursion did not reach. Their core.worktree may point to a path
# that no longer exists, so GIT_WORK_TREE overrides it (only config is used).
anon_module_dirs() {
  dirs=$(module_dirs_with real)
  [ -n "$dirs" ] || return 0
  md="$(git rev-parse --git-common-dir)/modules"
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    rel=${m#"$md"/}
    echo "submodule git dir '$rel'"
    # The top-level walk already covers nested module dirs, so only remotes and
    # submodule.*.url keys are handled here, without recursing again.
    (cd "$m" && GIT_DIR=$PWD GIT_WORK_TREE=$PWD && export GIT_DIR GIT_WORK_TREE &&
      anon_remotes "$1-$(san "$rel")" && anon_submodules "$base")
  done <<EOF
$dirs
EOF
}

anon_repo() {  # base (empty: reuse origin's alias or random)
  anon_remotes "$1"
  [ -n "$1" ] || base1=$base
  anon_submodules "${base1:-$1}"
  anon_module_dirs "${base1:-$1}"
  base1=
}

off_remotes() {
  RC=$(read_remotes)
  while read -r key val; do
    case "$val" in
      anon::*)
        real=$(lookup "${val#anon::}")
        [ -n "$real" ] || die "alias '${val#anon::}' not found in $MAP"
        git config "$key" "$real"
        echo "$key restored"
        ;;
    esac
  done <<EOF
$RC
EOF
}

off_repo() {
  off_remotes
  off_subs
  dirs=$(module_dirs_with anon)
  [ -n "$dirs" ] || return 0
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    (cd "$m" && GIT_DIR=$PWD GIT_WORK_TREE=$PWD && export GIT_DIR GIT_WORK_TREE && off_remotes && off_subs)
  done <<EOF
$dirs
EOF
}

off_subs() {
  LOC=$(read_local_sub)
  GM=$(read_gitmodules)
  names=$(sub_names "$GM" "$LOC")
  if [ -n "$names" ]; then
    sreal=$(super_real "$RC" "$LOC")
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      path=$(kv "$GM" "submodule.$name.path")
      cfg=$(kv "$LOC" "submodule.$name.url")
      case "$cfg" in
        anon::*)
          if [ "$(kv "$LOC" "submodule.$name.anoninactive")" = true ]; then
            git config --unset "submodule.$name.url"
            git config --unset "submodule.$name.active" || true
            git config --unset "submodule.$name.anonInactive"
            echo "submodule.$name restored (uninitialized)"
          else
            real=$(lookup "${cfg#anon::}")
            [ -n "$real" ] ||
              real=$(resolve_url "$sreal" "$(kv "$GM" "submodule.$name.url")") || exit 1
            git config "submodule.$name.url" "$real"
            echo "submodule.$name.url restored"
          fi
          ;;
      esac
      if [ -n "$path" ] && [ -e "$path/.git" ]; then
        (cd "$path" && echo "entering '$path'" && off_repo)
      fi
    done <<EOF
$names
EOF
  fi
}

status_repo() {  # prefix
  RC=$(read_remotes)
  printf '%s\n' "$RC" | while read -r key val; do
    case "$key" in remote.*.url) ;; *) continue ;; esac
    r=${key#remote.}; r=${r%.url}
    case "$val" in
      anon::*) echo "$1$r: anonymized ($val)" ;;
      *) echo "$1$r: NOT anonymized" ;;
    esac
  done
  LOC=$(read_local_sub)
  GM=$(read_gitmodules)
  names=$(sub_names "$GM" "$LOC")
  if [ -n "$names" ]; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      path=$(kv "$GM" "submodule.$name.path")
      u=$(kv "$LOC" "submodule.$name.url")
      case "$u" in
        anon::*) echo "$1submodule $name: anonymized ($u)" ;;
        '') echo "$1submodule $name: not initialized" ;;
        *) echo "$1submodule $name: NOT anonymized" ;;
      esac
      if [ -n "$path" ] && [ -e "$path/.git" ]; then
        (cd "$path" && status_repo "$1$path/")
      fi
    done <<EOF
$names
EOF
  fi
  md="$(git rev-parse --git-common-dir)/modules"
  module_dirs_with real | while IFS= read -r m; do
    [ -n "$m" ] && echo "$1submodule git dir ${m#"$md"/}: NOT anonymized"
  done
}

# update_repo <base>: init + clone submodules one level at a time, so every
# level is anonymized (and relative URLs resolved) before the next is cloned.
update_repo() {
  anon_repo "$1"
  names=$(submodule_names)
  [ -n "$names" ] || return 0
  git submodule --quiet init
  git submodule --quiet update </dev/null
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    git config --unset "submodule.$name.anonInactive" 2>/dev/null || true
    path=$(git config -f .gitmodules --get "submodule.$name.path" || true)
    u=$(git config --get "submodule.$name.url" || true)
    if [ -n "$path" ] && [ -e "$path/.git" ]; then
      (cd "$path" && update_repo "${u#anon::}")
    fi
  done <<EOF
$names
EOF
}

# ---- nested repositories ---------------------------------------------------
# Independent clones inside the working tree (e.g. third_party/x with its own
# .git directory) are not submodules, so git knows nothing about them. A `.git`
# *file* means a submodule or worktree, which its owning repo already handles.

# nested_repos [maxdepth]: one walk of the tree, never descending into .git
# or node_modules.
nested_repos() {
  if [ -n "${1:-}" ]; then
    find . -maxdepth "$1" -path ./.git -prune -o -name node_modules -prune \
      -o -name .git -type d -prune -print 2>/dev/null
  else
    find . -path ./.git -prune -o -name node_modules -prune \
      -o -name .git -type d -prune -print 2>/dev/null
  fi | sed 's#^\./##; s#/\.git$##'
}

# for_nested <function> <args...>: run <function> inside each nested repo.
for_nested() {
  fn=$1; shift
  repos=$(nested_repos)
  [ -n "$repos" ] || return 0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    (cd "$d" && echo "entering nested repo '$d'" && "$fn" "$d" "$@")
  done <<EOF
$repos
EOF
}

nested_init() {  # dir
  anon_repo ""
}

nested_off() { off_repo; }

nested_status() { status_repo "$1/"; }

to_toplevel() {
  in_repo
  top=$(git rev-parse --show-toplevel)
  cd "$top"
}

origin_alias() {
  u=$(git config --get remote.origin.url || true)
  case "$u" in
    anon::*) [ -z "$(lookup "${u#anon::}")" ] || echo "${u#anon::}" ;;
  esac
}

cmd_init() {
  base=
  while [ $# -gt 0 ]; do
    case "$1" in
      --alias) [ $# -ge 2 ] || die "--alias needs a value"; base=$2; shift 2 ;;
      --alias=*) base=${1#--alias=}; shift ;;
      --scrub-reflog) SCRUB=1; shift ;;
      --nested) NESTED=1; shift ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  to_toplevel
  [ -n "$(git remote)" ] || die "this repository has no remotes"
  # Reuse the existing alias on re-runs; otherwise random, because an alias
  # derived from the repo name would leak it.
  [ -n "$base" ] || base=$(origin_alias)
  [ -n "$base" ] || base="r$(rand_hex)"
  valid_alias "$base"
  ensure_map
  if [ -n "$SCRUB" ]; then
    echo "warning: --scrub-reflog rewrites files under .git/logs (and FETCH_HEAD), in every" >&2
    echo "         submodule too; on repositories with many refs this can take a long time" >&2
  fi
  if [ -n "$NESTED" ]; then
    echo "warning: --nested walks the whole working tree to find nested repositories;" >&2
    echo "         this can take a while on very large trees" >&2
  fi
  anon_repo "$base"
  if [ -n "$NESTED" ]; then
    for_nested nested_init
  else
    n=$(nested_repos 3 | grep -c . || true)
    if [ "$n" -gt 0 ]; then
      echo "note: found $n nested git repo(s) that are not submodules (e.g. third_party clones);"
      echo "      run \`git anon init --nested\` to anonymize them too"
    fi
  fi
  if [ -z "$SCRUB" ]; then
    echo "note: reflogs (.git/logs) may still contain the real URL, e.g. \"clone: from ...\";"
    echo "      run \`git anon init --scrub-reflog\` to remove it (can be slow on repos with many refs)"
  fi
}

cmd_update() {
  to_toplevel
  [ -n "$(git remote)" ] || die "this repository has no remotes"
  base=$(origin_alias)
  [ -n "$base" ] || base="r$(rand_hex)"
  ensure_map
  update_repo "$base"
}

cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
  init)   cmd_init "$@" ;;
  off|status)
    for a in "$@"; do
      case "$a" in
        --nested) NESTED=1 ;;
        *) die "unknown option '$a'" ;;
      esac
    done
    to_toplevel
    if [ "$cmd" = off ]; then
      off_repo
      [ -z "$NESTED" ] || for_nested nested_off
    else
      [ -n "$(git remote)$(submodule_names)" ] || echo "no remotes"
      status_repo ""
      [ -z "$NESTED" ] || for_nested nested_status
    fi
    ;;
  update) cmd_update ;;
  add)
    [ $# -ge 1 ] || die "usage: git anon add <alias> [remote]"
    in_repo
    ensure_map
    anonymize_remote "${2:-origin}" "$1"
    ;;
  restore)
    in_repo
    restore_key "${1:-origin}" url
    restore_key "${1:-origin}" pushurl
    ;;
  list)
    if [ -r "$MAP" ]; then
      awk '!/^[[:space:]]*(#|$)/ { print $1 }' "$MAP"
    fi
    ;;
  show)
    [ $# -ge 1 ] || die "usage: git anon show <alias>"
    real=$(lookup "$1")
    [ -n "$real" ] || die "unknown alias '$1'"
    echo "$real"
    ;;
  clone)
    rec=
    case "${1:-}" in
      --recurse-submodules|--recursive) rec=1; shift ;;
    esac
    [ $# -ge 1 ] || die "usage: git anon clone [--recurse-submodules] <alias> [dir]"
    valid_alias "$1"
    [ -n "$(lookup "$1")" ] || die "unknown alias '$1'"
    dir=${2:-$1}
    git clone "anon::$1" "$dir"
    if [ -n "$rec" ]; then
      cd "$dir"
      update_repo "$1"
    fi
    ;;
  version|--version) echo "git-anon $VERSION" ;;
  ''|help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
